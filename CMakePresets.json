{
  "version": 6,
  "configurePresets": [
    {
      "name": "host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host/cmake",
      "cacheVariables": { "BUILD_HOST": "ON", "BUILD_DEVICE": "OFF" }
    },
    {
      "name": "device",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/device/cmake",
      "cacheVariables": { "BUILD_HOST": "OFF", "BUILD_DEVICE": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "host", "configurePreset": "host", "targets": ["host"] },
    { "name": "device", "configurePreset": "device", "targets": ["hid-selftest"] }
  ]
}
