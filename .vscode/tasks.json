{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "identifier": "espkvm.build",
      "type": "process",
      "command": "/bin/bash",
      "args": ["scripts/wsl/build.sh", "build", "${input:target}"],
      "windows": {
        "command": "${env:SystemRoot}\\System32\\wsl.exe",
        "args": ["--exec", "bash", "scripts/wsl/build.sh", "build", "${input:target}"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "panel": "new", "reveal": "always" }
    },
    {
      "label": "rebuild",
      "identifier": "espkvm.rebuild",
      "type": "process",
      "command": "/bin/bash",
      "args": ["scripts/wsl/build.sh", "rebuild", "${input:target}"],
      "windows": {
        "command": "${env:SystemRoot}\\System32\\wsl.exe",
        "args": ["--exec", "bash", "scripts/wsl/build.sh", "rebuild", "${input:target}"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$gcc"],
      "presentation": { "panel": "new", "reveal": "always" }
    }
  ],
  "inputs": [
    {
      "id": "target",
      "type": "pickString",
      "description": "选择构建目标",
      "options": [
        { "label": "Device", "value": "device" },
        { "label": "Host", "value": "host" }
      ],
      "default": "device"
    }
  ]
}
